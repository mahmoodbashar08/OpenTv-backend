{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "opentv-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-31",
  "observability": { "enabled": true },

  // The social layer. Nothing a user owns is stored here — see docs/PLAN.md.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "opentv",
      // Filled in by: wrangler d1 create opentv
      "database_id": "REPLACE_ME",
      "migrations_dir": "migrations"
    }
  ],

  // Caches provider JWKS so token verification does not fetch on every request.
  "kv_namespaces": [
    { "binding": "CACHE", "id": "REPLACE_ME" }
  ]
}
