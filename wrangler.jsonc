{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "opentv-api",
  "main": "src/index.ts",
  // 2026-07-30 is the installed workerd's ceiling (1.20260730.1); a later date
  // makes `wrangler dev` error on every start.
  "compatibility_date": "2026-07-30",
  // node:buffer, for base64url handling of JWT segments in Step 1.
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // The night shift — docs/IMPLEMENTATION.md Step 5. 04:00 UTC is the trough
  // for a user base concentrated in Europe and the Middle East.
  "triggers": { "crons": ["0 4 * * *"] },

  // Public identifiers only — they appear in every client binary anyway.
  // Secrets (SESSION_SECRET, later REVENUECAT_WEBHOOK_SECRET) go in with
  // `wrangler secret put` and never live here. Locally they come from .dev.vars.
  "vars": {
    "APPLE_BUNDLE_ID": "com.insightfy.opentv",
    // Comma-separated: iOS, Android and **Web** client ids. Android sign-in
    // returns the *web* client id as `aud`, which is the classic trap. Filled
    // in when Google sign-in is wired up in the app; empty means every Google
    // token is refused, which is the correct direction to fail.
    "GOOGLE_CLIENT_IDS": "452943907676-p8tdhcpv1kfe92t8nf07vf6g5ao2m0mf.apps.googleusercontent.com,452943907676-vf096glumrms1bna4dcjhrtjo61f5kd1.apps.googleusercontent.com,452943907676-e39h1tgethjivr4eg5ao2n4i0hg2245d.apps.googleusercontent.com"
  },

  // The social layer. Nothing a user owns is stored here — see docs/PLAN.md.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "opentv",
      // Filled in by: wrangler d1 create opentv
      "database_id": "872adbe7-4735-4ef6-8cd2-620e443b1fbd",
      "migrations_dir": "migrations"
    }
  ],

  // Caches provider JWKS so token verification does not fetch on every request.
  "kv_namespaces": [
    { "binding": "CACHE", "id": "b87a5a9f72d345b5931ac00e34d17c61" }
  ],

  // Rescued TV Time comment photos. TV Time's CDN
  // (d12qk6n9ersps4.cloudfront.net) no longer resolves, so the only surviving
  // copies are the ones OpenTV downloaded to users' phones at import time —
  // this is where they are preserved. Nothing is SERVED from here until
  // `comment_images.scan_status` says 'clean'; see migration 0001.
  //
  // Profile pictures are the one thing here that IS served back out — see the
  // header of src/routes/avatars.ts, and the scanning caveat in it.
  "r2_buckets": [
    { "binding": "COMMENT_IMAGES", "bucket_name": "opentv-comment-images" },
    { "binding": "AVATARS", "bucket_name": "opentv-avatars" }
  ]
}
